# W3J MCP Hub - Environment Variables
# Copy this file to .env and add your actual values
# NEVER commit .env to git!

# ===== PRIMARY AI PROVIDER (Gemini 3 Pro) =====
GOOGLE_CLOUD_PROJECT=stellar-state-471406-f8
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3-pro-preview

# ===== N8N AUTOMATION =====
N8N_API_KEY=your_key_here
N8N_BASE_URL=https://n8n.aixlabs.fun/api/v1

# ===== SERVER PORTS =====
ORCHESTRATOR_PORT=7860
N8N_SERVER_PORT=7862
AGENT_SERVER_PORT=7863
LOCAL_SERVER_PORT=7864

# ===== OPTIONAL APIs =====
# Legacy Anthropic (no longer used)
ANTHROPIC_API_KEY=your_key_here

# OpenAI GPT-4 API
OPENAI_API_KEY=your_key_here

# GitHub Personal Access Token
GITHUB_TOKEN=your_token_here

# Composio (if using)
COMPOSIO_API_KEY=your_key_here

# ===== LOGGING =====
LOG_LEVEL=INFO
